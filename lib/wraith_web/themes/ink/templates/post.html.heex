<article class="ink-post">
  <p class="ink-muted">
    <span :if={@post["published_at"]}>{String.slice(@post["published_at"], 0, 10)}</span>
    <span :for={t <- @post["tags"] || []}><.link navigate={~p"/tag/#{t}"}>#{t}</.link></span>
    <span :if={@author}>by
    <.link navigate={~p"/author/#{@author["slug"]}"}>{@author["name"]}</.link></span>
    <span :if={@post["status"] != "published"} class="ink-badge">{@post["status"]}</span>
    <.link :if={@current_user} navigate={~p"/admin/posts/#{@post["id"]}"}>[edit]</.link>
  </p>
  <h1>{@post["title"]}</h1>
  <img :if={@post["feature_image"]} src={@post["feature_image"]} alt="" class="ink-figure" />
  <.body :if={@locked and @segments != []} segments={@segments} widgets={@widgets} />
  <div :if={@locked} class="ink-lock">
    <p>
      // {@post["visibility"]} members only — <.link navigate={~p"/subscribe"}>subscribe</.link>
      or <.link navigate={~p"/members"}>sign in</.link>
      to read on
    </p>
  </div>
  <.toc :if={not @locked} toc={@toc} />
  <.body :if={not @locked} segments={@segments} widgets={@widgets} />
  <.comments
    :if={not @locked}
    enabled={@comments_enabled}
    comments={@comments}
    current_member={@current_member}
    current_user={@current_user}
    reply_to={@reply_to}
  />
</article>
<section :if={@related != []} class="ink-intro">
  <p class="ink-muted">// read next</p>
  <ol class="ink-list">
    <li :for={post <- @related}>
      <time datetime={post["published_at"]}>{String.slice(post["published_at"] || "", 0, 10)}</time>
      <.link navigate={~p"/#{post["slug"]}"}>{post["title"]}</.link>
    </li>
  </ol>
</section>
