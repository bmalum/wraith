<section class="ink-intro">
  <h1>search</h1>
  <form phx-change="search" phx-submit="search" class="ink-form" id="search-form">
    <label>q
    <input type="search" name="q" value={@q} autofocus autocomplete="off" phx-debounce="200" /></label>
  </form>
  <p :if={@q != ""} class="ink-muted">{length(@results)} result(s)</p>
</section>
<ol class="ink-list">
  <li :for={r <- @results}>
    <time datetime={r.post["published_at"]}>{String.slice(r.post["published_at"] || "", 0, 10)}</time>
    <.link navigate={~p"/#{r.post["slug"]}"}>{r.post["title"]}</.link>
  </li>
</ol>
