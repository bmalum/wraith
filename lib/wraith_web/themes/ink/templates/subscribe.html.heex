<section class="ink-intro">
  <h1>subscribe</h1>
  <p>New posts by mail. No spam.</p>
</section>
<p :if={@done} class="ink-ok" role="status">// you're in. thanks for reading.</p>
<.form :if={not @done} for={@form} phx-submit="subscribe" class="ink-form" id="subscribe-form">
  <label>name <input type="text" name="name" value={@form[:name].value} placeholder="optional" /></label>
  <label>email
  <input
    type="email"
    name="email"
    value={@form[:email].value}
    required
    placeholder="you@example.com"
  /></label>
  <button type="submit">subscribe →</button>
</.form>
