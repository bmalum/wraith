<section class="ink-intro">
  <h1>#{@tag["slug"]}</h1>
  <p :if={@tag["description"] not in [nil, ""]}>{@tag["description"]}</p>
  <p class="ink-muted">{length(@posts)} post(s)</p>
</section>
<ol class="ink-list">
  <li :for={post <- @posts}>
    <time datetime={post["published_at"]}>{String.slice(post["published_at"] || "", 0, 10)}</time>
    <.link navigate={~p"/#{post["slug"]}"}>{post["title"]}</.link>
  </li>
</ol>
