<div class="ink">
  <header class="ink-head">
    <a href="/" class="ink-brand">~/{Wraith.Slug.slugify(@site["title"])}</a>
    <nav class="ink-nav" aria-label="Site">
      <a :for={item <- @site["navigation"] || []} href={item["url"]}>{item["label"]}</a>
      <a :if={@site["members_enabled"]} href={~p"/subscribe"}>subscribe</a>
      <a href={~p"/search"}>search</a>
      <a href={~p"/rss"}>rss</a>
      <a :if={@current_user} href={~p"/admin"} title="Admin">admin</a>
    </nav>
  </header>
  <main class="ink-main">{render_slot(@inner_block)}</main>
  <footer class="ink-foot">
    <span>© {Date.utc_today().year} {@site["title"]}</span>
    <span :if={@site["footer"] not in [nil, ""]}>{@site["footer"]}</span>
    <span>wraith</span>
  </footer>
</div>
