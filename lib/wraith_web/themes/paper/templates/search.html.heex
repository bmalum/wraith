<section class="lead is-small">
  <h1 class="lead-title">Search</h1>
  <form phx-change="search" phx-submit="search" class="search-form" id="search-form">
    <input
      type="search"
      name="q"
      value={@q}
      placeholder="Search posts…"
      autofocus
      autocomplete="off"
      phx-debounce="200"
      class="input is-search"
    />
  </form>
  <p :if={@q != ""} class="lead-count">
    {length(@results)} {if length(@results) == 1, do: "result", else: "results"} for “{@q}”
  </p>
</section>
<section class="search-results">
  <article :for={r <- @results} class="search-hit">
    <h2><.link navigate={~p"/#{r.post["slug"]}"}>{r.post["title"]}</.link></h2>
    <p>{r.snippet}</p>
    <.byline post={Map.put(r.post, "markdown", "")} authors={@authors} />
  </article>
</section>
