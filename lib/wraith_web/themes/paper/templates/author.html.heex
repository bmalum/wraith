<section class="lead is-small">
  <img
    :if={@author["avatar"]}
    src={@author["avatar"]}
    alt=""
    class="author-avatar is-large is-img"
  />
  <div :if={is_nil(@author["avatar"])} class="author-avatar is-large">
    {String.first(@author["name"])}
  </div>
  <h1 class="lead-title">{@author["name"]}</h1>
  <p :if={@author["bio"] not in [nil, ""]} class="lead-desc">{@author["bio"]}</p>
  <p class="author-links">
    <span :if={@author["location"] not in [nil, ""]}>{@author["location"]}</span>
    <a :if={@author["website"] not in [nil, ""]} href={@author["website"]} rel="me noopener">Website</a>
    <a
      :if={@author["twitter"] not in [nil, ""]}
      href={"https://x.com/" <> String.trim_leading(@author["twitter"], "@")}
      rel="me noopener"
    >X</a>
    <a
      :if={@author["github"] not in [nil, ""]}
      href={"https://github.com/" <> @author["github"]}
      rel="me noopener"
    >GitHub</a>
    <a :if={@author["mastodon"] not in [nil, ""]} href={@author["mastodon"]} rel="me noopener">Mastodon</a>
  </p>
  <p class="lead-count">{length(@posts)} {if length(@posts) == 1, do: "post", else: "posts"}</p>
</section>
<section class="feed">
  <.post_card :for={post <- @posts} post={post} authors={@authors} />
</section>
