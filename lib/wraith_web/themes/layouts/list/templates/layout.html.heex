<div class="l-list">
  <header class="l-list-head">
    <a href="/" class="l-list-brand">~/{Wraith.Slug.slugify(@site["title"])}</a>
    <.nav_toggle />
    <nav class="l-list-nav t-nav" id="site-nav" aria-label="Site">
      <a :for={item <- @site["navigation"] || []} href={item["url"]}>{item["label"]}</a>
      <a href={~p"/search"}>search</a>
      <a :if={@site["members_enabled"] and is_nil(assigns[:current_member])} href={~p"/subscribe"}>subscribe</a>
      <a :if={assigns[:current_member]} href={~p"/members"}>account</a>
      <a href={~p"/rss"}>rss</a>
      <a :if={@current_user} href={~p"/admin"}>admin</a>
      <.mode_toggle />
    </nav>
  </header>
  <main class="l-list-main" id="main" tabindex="-1">{render_slot(@inner_block)}</main>
  <footer class="l-list-foot">
    <span>© {Date.utc_today().year} {@site["title"]}</span>
    <.site_credit site={@site} />
    <span>wraith</span>
  </footer>
</div>
