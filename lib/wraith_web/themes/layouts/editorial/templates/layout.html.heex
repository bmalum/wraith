<div class="site l-editorial">
  <header class="masthead">
    <div class="masthead-inner">
      <a href="/" class="masthead-title">
        <img
          :if={@site["logo"] not in [nil, ""]}
          src={@site["logo"]}
          alt={@site["title"]}
          class="masthead-logo"
        />
        <span :if={@site["logo"] in [nil, ""]}>{@site["title"]}</span>
      </a>
      <nav class="masthead-nav" aria-label="Site">
        <a :for={item <- @site["navigation"] || []} href={item["url"]}>{item["label"]}</a>
        <a href={~p"/search"} class="masthead-icon" title="Search" aria-label="Search"><.icon
          name="hero-magnifying-glass"
          class="size-4"
        /></a>
        <.mode_toggle />
        <a
          :if={@site["members_enabled"] and is_nil(assigns[:current_member])}
          href={~p"/subscribe"}
          class="masthead-cta"
        >Subscribe</a>
        <a :if={assigns[:current_member]} href={~p"/members"} class="masthead-cta">Account</a>
        <a :if={@current_user} href={~p"/admin"} class="masthead-icon" title="Admin"><.icon
          name="hero-pencil-square"
          class="size-4"
        /></a>
      </nav>
    </div>
  </header>
  <main class="site-main">{render_slot(@inner_block)}</main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <span>{@site["title"]} © {Date.utc_today().year}</span>
      <span class="site-footer-links">
        <.social_links site={@site} />
        <span :if={@site["footer"] not in [nil, ""]}>{@site["footer"]}</span>
        <span>Published with <a href="https://github.com/mkarrer/wraith">Wraith</a></span>
      </span>
    </div>
  </footer>
</div>
