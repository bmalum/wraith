<section class="t-head is-center">
  <p :if={@kicker} class="t-kicker">{@kicker}</p>
  <.author_meta :if={assigns[:author]} author={@author} />
  <h1 class="t-title">{@heading}</h1>
  <p :if={@lede not in [nil, ""]} class="t-lede">{@lede}</p>
  <.search_form :if={assigns[:search]} q={@q} />
  <.listing_count posts={@posts} search={assigns[:search] == true} />
</section>
<section class="l-grid-cards">
  <article :for={post <- @posts} class="l-grid-card">
    <.link navigate={~p"/#{post["slug"]}"} class="l-grid-card-img">
      <.feature_img post={post} sizes={:card} alt="" />
      <span :if={is_nil(post["feature_image"])} class="l-grid-card-blank">{String.first(
        post["title"]
      )}</span>
    </.link>
    <div class="l-grid-card-body">
      <h2><.link navigate={~p"/#{post["slug"]}"}>{post["title"]}</.link></h2>
      <p>{post["excerpt"]}</p>
    </div>
  </article>
</section>
