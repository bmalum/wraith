<div class="l-mag">
  <header class="l-mag-head">
    <div class="l-mag-top">
      <span class="l-mag-date">{Calendar.strftime(Date.utc_today(), "%A, %B %-d, %Y")}</span>
      <div class="l-mag-tools">
        <a href={~p"/search"} class="masthead-icon" aria-label={gettext("Search")}><.icon
          name="hero-magnifying-glass"
          class="size-4"
        /></a>
        <.mode_toggle />
        <a :if={assigns[:current_member]} href={~p"/members"}>{gettext("Account")}</a>
        <a :if={@current_user} href={~p"/admin"}>{gettext("Admin")}</a>
      </div>
    </div>
    <a href="/" class="l-mag-brand">
      <img :if={@site["logo"] not in [nil, ""]} src={@site["logo"]} alt={@site["title"]} />
      <span :if={@site["logo"] in [nil, ""]}>{@site["title"]}</span>
    </a>
    <.nav_toggle />
    <nav class="l-mag-nav t-nav" id="site-nav" aria-label={gettext("Site")}>
      <a :for={item <- @site["navigation"] || []} href={item["url"]}>{item["label"]}</a>
      <a
        :for={t <- WraithWeb.Themes.Layouts.Magazine.sidebar_tags() |> Enum.take(5)}
        href={~p"/tag/#{t["slug"]}"}
      >{t["name"]}</a>
    </nav>
  </header>
  <main class="l-mag-main" id="main" tabindex="-1">{render_slot(@inner_block)}</main>
  <footer class="l-mag-foot">
    <span>{@site["title"]} © {Date.utc_today().year}</span>
    <.social_links site={@site} />
    <.site_credit site={@site} />
  </footer>
</div>
