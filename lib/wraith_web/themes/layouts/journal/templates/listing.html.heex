<section class="t-head">
  <p :if={@kicker} class="t-kicker">{@kicker}</p>
  <.author_meta :if={assigns[:author]} author={@author} />
  <h1 class="t-title">{@heading}</h1>
  <p :if={@lede not in [nil, ""]} class="t-lede">{@lede}</p>
  <.search_form :if={assigns[:search]} q={@q} />
  <.listing_count posts={@posts} search={assigns[:search] == true} />
</section>
<section class="l-jrn-entries">
  <article :for={post <- @posts} class="l-jrn-entry">
    <time datetime={post["published_at"]} class="l-jrn-date"><span class="l-jrn-day">{day(
      post["published_at"]
    )}</span><span class="l-jrn-month">{month(post["published_at"])}</span></time>
    <div class="l-jrn-entry-body">
      <h2><.link navigate={~p"/#{post["slug"]}"}>{post["title"]}</.link></h2><p>
        {post["excerpt"]}
      </p>
    </div>
  </article>
</section>
