<div :if={@posts == []} class="t-empty">
  <p>Nothing published yet.</p>
</div>
<section class="l-jrn-entries">
  <article :for={post <- @posts} class="l-jrn-entry">
    <time datetime={post["published_at"]} class="l-jrn-date">
      <span class="l-jrn-day">{day(post["published_at"])}</span>
      <span class="l-jrn-month">{month(post["published_at"])}</span>
    </time>
    <div class="l-jrn-entry-body">
      <h2><.link navigate={~p"/#{post["slug"]}"}>{post["title"]}</.link></h2>
      <p>{post["excerpt"]}</p>
      <p class="l-jrn-more">
        <.link navigate={~p"/#{post["slug"]}"}>Continue reading →</.link><span
          :for={t <- Enum.take(post["tags"] || [], 2)}
          class="l-jrn-tag"
        ><.link navigate={~p"/tag/#{t}"}>{t}</.link></span>
      </p>
    </div>
  </article>
</section>
<.pager
  page={@page}
  has_next={@has_next}
  path={fn n -> if n == 1, do: ~p"/", else: ~p"/page/#{n}" end}
/>
