<!DOCTYPE html>
<html
  lang={(assigns[:site] && @site["lang"]) || "en"}
  data-layout={assigns[:theme] && @theme.info().layout_name}
  data-skin={assigns[:theme] && @theme.info().name}
  data-scheme={assigns[:theme] && (@theme.info().tokens["--scheme"] || "light")}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title
      default={(assigns[:site] && assigns[:site]["title"]) || "Wraith"}
      suffix={" · " <> ((assigns[:site] && assigns[:site]["title"]) || "Wraith")}
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <%= if assigns[:meta] do %>
      <link :if={@meta[:canonical]} rel="canonical" href={@meta[:canonical]} />
      <meta property="og:site_name" content={(assigns[:site] && @site["title"]) || "Wraith"} />
      <meta property="og:type" content={@meta[:type] || "website"} />
      <meta property="og:title" content={@meta[:title]} />
      <meta :if={@meta[:description]} property="og:description" content={@meta[:description]} />
      <meta :if={@meta[:url]} property="og:url" content={@meta[:url]} />
      <meta :if={@meta[:image]} property="og:image" content={@meta[:image]} />
      <meta
        :if={@meta[:published_at]}
        property="article:published_time"
        content={@meta[:published_at]}
      />
      <meta :for={tag <- @meta[:tags] || []} property="article:tag" content={tag} />
      <meta
        name="twitter:card"
        content={if @meta[:image], do: "summary_large_image", else: "summary"}
      />
      <meta name="twitter:title" content={@meta[:title]} />
      <meta :if={@meta[:description]} name="twitter:description" content={@meta[:description]} />
      <meta :if={@meta[:image]} name="twitter:image" content={@meta[:image]} />
    <% end %>
    <meta :if={assigns[:noindex]} name="robots" content="noindex" />
    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= Phoenix.HTML.raw(@json_ld) %>
      </script>
    <% end %>
    <link :if={assigns[:site] && @site["icon"] not in [nil, ""]} rel="icon" href={@site["icon"]} />
    <meta
      :if={assigns[:site] && @site["twitter"] not in [nil, ""]}
      name="twitter:site"
      content={@site["twitter"]}
    />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={~p"/rss"} />
    <link rel="alternate" type="application/feed+json" title="JSON Feed" href={~p"/feed.json"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <Layouts.theme_head theme={assigns[:theme]} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      try { const m = localStorage.getItem("wraith:mode"); if (m) document.documentElement.dataset.mode = m } catch (e) {}
    </script>
    <style :if={assigns[:site] && @site["accent"] not in [nil, ""]}>
      :root { --accent: <%= @site["accent"] %>; }
    </style>
    <%= if assigns[:site] && @site["code_injection_head"] not in [nil, ""] do %>
      {Phoenix.HTML.raw(@site["code_injection_head"])}
    <% end %>
  </head>
  <body>
    <a :if={assigns[:theme]} href="#main" class="skip-link">Skip to content</a>
    {@inner_content}
    <%= if assigns[:site] && @site["code_injection_foot"] not in [nil, ""] do %>
      {Phoenix.HTML.raw(@site["code_injection_foot"])}
    <% end %>
  </body>
</html>
