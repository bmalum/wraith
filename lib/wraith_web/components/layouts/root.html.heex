<!DOCTYPE html>
<html lang={assigns[:site][:lang] || "en"} data-theme="wraith">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title
      default={(assigns[:site] && assigns[:site]["title"]) || "Wraith"}
      suffix={" · " <> ((assigns[:site] && assigns[:site]["title"]) || "Wraith")}
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <meta :if={assigns[:meta_description]} name="description" content={@meta_description} />
    <%= if assigns[:meta] do %>
      <link :if={@meta[:canonical]} rel="canonical" href={@meta[:canonical]} />
      <meta property="og:site_name" content={(assigns[:site] && @site["title"]) || "Wraith"} />
      <meta property="og:type" content={@meta[:type] || "website"} />
      <meta property="og:title" content={@meta[:title]} />
      <meta :if={@meta[:description]} property="og:description" content={@meta[:description]} />
      <meta :if={@meta[:url]} property="og:url" content={@meta[:url]} />
      <meta :if={@meta[:image]} property="og:image" content={@meta[:image]} />
      <meta :if={@meta[:published_at]} property="article:published_time" content={@meta[:published_at]} />
      <meta :for={tag <- @meta[:tags] || []} property="article:tag" content={tag} />
      <meta name="twitter:card" content={if @meta[:image], do: "summary_large_image", else: "summary"} />
      <meta name="twitter:title" content={@meta[:title]} />
      <meta :if={@meta[:description]} name="twitter:description" content={@meta[:description]} />
      <meta :if={@meta[:image]} name="twitter:image" content={@meta[:image]} />
    <% end %>
    <link rel="alternate" type="application/rss+xml" title="RSS" href={~p"/rss"} />
    <link rel="alternate" type="application/feed+json" title="JSON Feed" href={~p"/feed.json"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link :if={assigns[:theme]} phx-track-static rel="stylesheet" href={@theme.info().css} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <style :if={assigns[:site] && assigns[:site]["accent"]}>
      :root { --accent: <%= @site["accent"] %>; }
    </style>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
