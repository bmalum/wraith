# Wraith — environment (config/runtime.exs reads these; copy to .env and `source` it)

PORT=4000
# SECRET_KEY_BASE=   # prod only: mix phx.gen.secret
# PHX_HOST=blog.example.com      # prod only, required: the public hostname
# WRAITH_VAULT_KEY=  # prod only, required: mix phx.gen.secret — encrypts stored secrets (Stripe, Kiro); changing it loses them
# TRUSTED_PROXIES=1  # how many proxies/load balancers sit in front (1 for an ALB); rate limits trust only their X-Forwarded-For hop

# ---- storage: one table ------------------------------------------------------------
# memory   in-process ETS (dev default, nothing persists)
# dynamo   DynamoDB (WRAITH_TABLE, AWS_* below; DYNAMO_ENDPOINT for DynamoDB Local)
# postgres PostgreSQL: DATABASE_URL=postgres://user:pass@host:5432/db  (DATABASE_SSL=true for TLS)
# dsql     Aurora DSQL: DSQL_ENDPOINT=<cluster>.dsql.<region>.on.aws, IAM auth via AWS_* (DSQL_USER=admin)
WRAITH_STORE=memory
WRAITH_TABLE=wraith
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/wraith
# DSQL_ENDPOINT=
# POOL_SIZE=10
AWS_REGION=eu-central-1
# AWS_PROFILE=my-profile              # local credentials; deployed tasks use the task role
# DYNAMO_ENDPOINT=http://localhost:8000   # DynamoDB Local (docker compose up -d)

# ---- the agent studio (Kiro on a Lambda MicroVM) ---------------------------------
# Unset = the offline scripted agent. All four are printed by microvm/build.sh.
# WRAITH_MICROVM_IMAGE_ARN=
# WRAITH_MICROVM_IMAGE_VERSION=
# WRAITH_MICROVM_EXECUTION_ROLE_ARN=
# WRAITH_JOURNAL_BUCKET=
# KIRO_API_KEY=ksk_...               # or paste it in /admin/studio (stored encrypted)

# ---- mail (Swoosh) --------------------------------------------------------------------
# dev: mails open at http://localhost:4000/dev/mailbox; prod: Amazon SES through the AWS_* chain
# MAIL_FROM=hello@example.com

# ---- uploads ---------------------------------------------------------------------------
# unset = local disk (UPLOADS_DIR, default priv/uploads) served at /uploads
# UPLOADS_BUCKET=my-bucket
# UPLOADS_PREFIX=uploads
# UPLOADS_URL=https://cdn.example.com

# Stripe keys and prices are set in /admin/settings (stored in the site item), not here.
